From 5074f99296a39aa7cb584cd9c38c1f8587b3157f Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@fyralabs.com>
Date: Fri, 23 Oct 2026 15:35:58 +0700
Subject: [PATCH] autosync: handle empty State.metadata

SugarCube's State.metadata.entries() returns null rather than an empty
array when no metadata has been stored, which is always the case for DoL.
Array.from(null) then throws, so every sync failed with "object null is
not iterable" and saves were never sent to the server.
---
 extension/autosync/autosync.ts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/extension/autosync/autosync.ts b/extension/autosync/autosync.ts
index 208a124..45d9391 100644
--- a/extension/autosync/autosync.ts
+++ b/extension/autosync/autosync.ts
@@ -56,7 +56,9 @@ async function sync() {
   const data = SugarCube.Save.serialize({
     // As far as I can tell, none of DoL uses SugarCube.State.metadata, so
     // we'll just go ahead and use it however we want.
-    stateMetadata: Array.from(SugarCube.State.metadata.entries()),
+    // State.metadata.entries() returns null when nothing has been stored yet,
+    // which is always the case for DoL.
+    stateMetadata: Array.from(SugarCube.State.metadata.entries() ?? []),
   });
   if (data == null) {
     return;
-- 
2.55.0

